{
    "name": "laboiteacode/laravel-monitor",
    "description": "Client SDK to report exceptions, logs, dependencies and heartbeats from a Laravel application to a LaravelMonitor server.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "laravel",
        "monitoring",
        "exceptions",
        "error-tracking",
        "logging",
        "heartbeats",
        "backups"
    ],
    "authors": [
        {
            "name": "La boite a code",
            "email": "alexandre@laboiteacode.fr"
        }
    ],
    "homepage": "https://github.com/La-boite-a-code/LaravelMonitor",
    "support": {
        "issues": "https://github.com/La-boite-a-code/LaravelMonitor/issues",
        "source": "https://github.com/La-boite-a-code/LaravelMonitor"
    },
    "require": {
        "php": "^8.2",
        "ext-phar": "*",
        "laboiteacode/monitor-php": "^0.1",
        "illuminate/bus": "^11.0|^12.0|^13.0",
        "illuminate/console": "^11.0|^12.0|^13.0",
        "illuminate/contracts": "^11.0|^12.0|^13.0",
        "illuminate/http": "^11.0|^12.0|^13.0",
        "illuminate/log": "^11.0|^12.0|^13.0",
        "illuminate/queue": "^11.0|^12.0|^13.0",
        "illuminate/support": "^11.0|^12.0|^13.0",
        "psr/log": "^2.0|^3.0",
        "symfony/process": "^7.0|^8.0"
    },
    "require-dev": {
        "orchestra/testbench": "^9.0|^10.0|^11.0"
    },
    "autoload": {
        "psr-4": {
            "LaBoiteACode\\LaravelMonitor\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "LaBoiteACode\\LaravelMonitor\\Tests\\": "tests/"
        }
    },
    "repositories": [
        {
            "type": "path",
            "url": "../monitor-php",
            "options": {
                "versions": {
                    "laboiteacode/monitor-php": "0.1.0"
                }
            }
        }
    ],
    "extra": {
        "laravel": {
            "providers": [
                "LaBoiteACode\\LaravelMonitor\\LaravelMonitorServiceProvider"
            ],
            "aliases": {
                "Monitor": "LaBoiteACode\\LaravelMonitor\\Facades\\Monitor"
            }
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
