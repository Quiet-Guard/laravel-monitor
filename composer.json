{
    "name": "quiet-guard/laravel-monitor",
    "description": "Client SDK to report exceptions, logs, dependencies and heartbeats from a Laravel application to a Quiet Guard server.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "laravel",
        "monitoring",
        "exceptions",
        "error-tracking",
        "logging",
        "heartbeats",
        "backups"
    ],
    "authors": [
        {
            "name": "Alexandre Ribes",
            "email": "alexandre@laboiteacode.fr",
            "homepage": "https://quietguard.dev"
        }
    ],
    "homepage": "https://github.com/Quiet-Guard/laravel-monitor",
    "support": {
        "issues": "https://github.com/Quiet-Guard/laravel-monitor/issues",
        "source": "https://github.com/Quiet-Guard/laravel-monitor"
    },
    "require": {
        "php": "^8.2",
        "ext-phar": "*",
        "quiet-guard/monitor-php": "^0.2",
        "illuminate/bus": "^11.0|^12.0|^13.0",
        "illuminate/console": "^11.0|^12.0|^13.0",
        "illuminate/contracts": "^11.0|^12.0|^13.0",
        "illuminate/http": "^11.0|^12.0|^13.0",
        "illuminate/log": "^11.0|^12.0|^13.0",
        "illuminate/queue": "^11.0|^12.0|^13.0",
        "illuminate/support": "^11.0|^12.0|^13.0",
        "psr/log": "^2.0|^3.0",
        "symfony/process": "^7.0|^8.0"
    },
    "require-dev": {
        "orchestra/testbench": "^9.0|^10.0|^11.0"
    },
    "autoload": {
        "psr-4": {
            "QuietGuard\\LaravelMonitor\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "QuietGuard\\LaravelMonitor\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "QuietGuard\\LaravelMonitor\\LaravelMonitorServiceProvider"
            ],
            "aliases": {
                "Monitor": "QuietGuard\\LaravelMonitor\\Facades\\Monitor"
            }
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
